set_location_assignment PIN_AB15 -to I2C_SCL
set_location_assignment PIN_AA15 -to GPIO_A
set_location_assignment PIN_Y16  -to GPIO_B
set_location_assignment PIN_V17  -to LVDS_TX_P[0]
set_location_assignment PIN_W17  -to "LVDS_TX_P[0](n)"
set_location_assignment PIN_V16  -to LVDS_TX_P[1]
set_location_assignment PIN_U15  -to "LVDS_TX_P[1](n)"
set_location_assignment PIN_W15  -to LVDS_TX_P[2]
set_location_assignment PIN_V14  -to "LVDS_TX_P[2](n)"
